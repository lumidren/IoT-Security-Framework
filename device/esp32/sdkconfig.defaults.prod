# ---- prod: release images. Gate: tools/check_prod_config.py (CI). ----------------------------
# The matching eFuses are burned by tools/factory_provision.py --profile prod (IRREVERSIBLE).
CONFIG_IRONMESH_SE_ATECC608=y
CONFIG_IRONMESH_DUT_CONTROL=n
CONFIG_IRONMESH_REQUIRE_PQ=n

# Secure Boot v2. RSA-PSS-3072 is the scheme for ESP32 (ECO3+) and ESP32-S3; for ECDSA-only
# chips (ESP32-C2) factory_provision.py switches to CONFIG_SECURE_SIGNED_APPS_ECDSA_V2_SCHEME.
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
# On the ESP32 target, Secure Boot v2 (RSA) requires chip revision v3.0 (ECO3) or later; without
# this minimum IDF falls back to Secure Boot v1 (ECDSA). ESP32-WROOM-32E modules are ECO3. The
# option does not exist for ESP32-S3 and is ignored there.
CONFIG_ESP32_REV_MIN_3=y
CONFIG_SECURE_BOOT_INSECURE=n
CONFIG_SECURE_BOOT_ALLOW_ROM_BASIC=n
CONFIG_SECURE_BOOT_ALLOW_JTAG=n
CONFIG_SECURE_BOOT_ALLOW_SHORT_APP_PARTITION=n

# Flash encryption, release mode
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_ENC=n
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_DEC=n
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_CACHE=n
CONFIG_NVS_SEC_KEY_PROTECT_USING_FLASH_ENC=y

# No ROM download mode, no JTAG, no console, no logs
CONFIG_SECURE_DISABLE_ROM_DL_MODE=y
CONFIG_SECURE_ENABLE_SECURE_ROM_DL_MODE=n
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_MAXIMUM_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT=y
CONFIG_ESP_DEBUG_OCDAWARE=n
CONFIG_APPTRACE_DEST_NONE=y

# Anti-rollback with the eFuse secure version (32 one-time bits = 32 security epochs; the
# manifest version_code is the fine-grained anti-rollback counter, see README)
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=y
CONFIG_BOOTLOADER_APP_SECURE_VERSION=1
CONFIG_BOOTLOADER_APP_SEC_VER_SIZE_EFUSE_FIELD=32

# Hardening
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
