{
  "openapi": "3.1.0",
  "info": {
    "title": "IronMesh Policy Service",
    "version": "1.0.0",
    "description": "EMQX authentication/authorization backend, revocation cache and policy management API (API_CONTRACT.md section 4)."
  },
  "servers": [{ "url": "http://policy:8081" }],
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT (console OIDC access token: RS256/PS256/ES256 via the issuer JWKS, aud=ironmesh-api; or ES256 service JWT, aud=policy)" }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "errors": { "type": "array", "items": { "type": "string" } }
        }
      },
      "Policy": {
        "type": "object",
        "required": ["version", "updated_at", "updated_by", "rego", "sha256_hex"],
        "properties": {
          "version": { "type": "integer" },
          "updated_at": { "type": "string", "format": "date-time" },
          "updated_by": { "type": "string" },
          "rego": { "type": "string" },
          "sha256_hex": { "type": "string" }
        }
      },
      "PolicyUpdate": {
        "type": "object",
        "required": ["rego"],
        "properties": { "rego": { "type": "string" }, "message": { "type": "string", "maxLength": 512 } }
      },
      "PolicyVersionRef": {
        "type": "object",
        "properties": { "version": { "type": "integer" }, "sha256_hex": { "type": "string" } }
      },
      "EvaluateRequest": {
        "type": "object",
        "required": ["input"],
        "properties": {
          "input": {
            "type": "object",
            "required": ["clientid", "topic", "action"],
            "properties": {
              "clientid": { "type": "string" },
              "username": { "type": "string" },
              "tenant_id": { "type": "string" },
              "device_id": { "type": "string" },
              "kind": { "type": "string", "enum": ["device", "service"] },
              "topic": { "type": "string" },
              "action": { "type": "string", "enum": ["publish", "subscribe"] },
              "qos": { "type": "integer", "minimum": 0, "maximum": 2 },
              "retain": { "type": "boolean" }
            }
          }
        }
      },
      "EvaluateResponse": {
        "type": "object",
        "properties": {
          "result": { "type": "string", "enum": ["allow", "deny"] },
          "matched_rules": { "type": "array", "items": { "type": "string" } },
          "trace": { "type": "array", "items": { "type": "string" } },
          "evaluated_version": { "type": "integer" },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      },
      "HistoryItem": {
        "type": "object",
        "properties": {
          "version": { "type": "integer" },
          "updated_at": { "type": "string", "format": "date-time" },
          "updated_by": { "type": "string" },
          "message": { "type": "string" },
          "sha256_hex": { "type": "string" }
        }
      },
      "Revocation": {
        "type": "object",
        "properties": {
          "serial_hex": { "type": "string" },
          "device_id": { "type": "string" },
          "tenant_id": { "type": "string" },
          "reason": { "type": "string" },
          "revoked_at": { "type": "string", "format": "date-time" },
          "applied_at": { "type": "string", "format": "date-time" },
          "kicked": { "type": "boolean" },
          "kicked_at": { "type": "string", "format": "date-time" },
          "source": { "type": "string", "enum": ["event", "crl"] },
          "event_id": { "type": "string" }
        }
      }
    },
    "parameters": {
      "cursor": { "name": "cursor", "in": "query", "schema": { "type": "string" } },
      "limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } }
    }
  },
  "paths": {
    "/v1/policy": {
      "get": {
        "summary": "Active Rego policy (admin)",
        "security": [{ "bearer": [] }],
        "responses": {
          "200": { "description": "Active policy", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Policy" } } } },
          "401": { "description": "Unauthenticated" },
          "403": { "description": "Forbidden" }
        }
      },
      "put": {
        "summary": "Publish a new policy version (owner)",
        "security": [{ "bearer": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PolicyUpdate" } } } },
        "responses": {
          "200": { "description": "Stored and hot-swapped", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PolicyVersionRef" } } } },
          "422": { "description": "Compiler or invariant-test diagnostics", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/v1/policy/evaluate": {
      "post": {
        "summary": "Dry-run a decision with tracing (operator); never cached",
        "security": [{ "bearer": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EvaluateRequest" } } } },
        "responses": {
          "200": { "description": "Decision", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EvaluateResponse" } } } },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/v1/policy/history": {
      "get": {
        "summary": "Policy versions, newest first (viewer)",
        "security": [{ "bearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/cursor" }, { "$ref": "#/components/parameters/limit" }],
        "responses": {
          "200": {
            "description": "Page",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/HistoryItem" } }, "next_cursor": { "type": ["string", "null"] } } } } }
          }
        }
      }
    },
    "/v1/revocations": {
      "get": {
        "summary": "Revocation cache entries (viewer)",
        "security": [{ "bearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/cursor" }, { "$ref": "#/components/parameters/limit" }],
        "responses": {
          "200": {
            "description": "Page",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Revocation" } }, "next_cursor": { "type": ["string", "null"] } } } } }
          }
        }
      }
    },
    "/emqx/authn": { "post": { "summary": "EMQX HTTP authentication backend (internal)", "responses": { "200": { "description": "{result: allow|deny, client_attrs}" } } } },
    "/emqx/authz": { "post": { "summary": "EMQX HTTP authorization backend (internal)", "responses": { "200": { "description": "{result: allow|deny}" } } } },
    "/internal/v1/revocations": { "post": { "summary": "Signed PKI revocation event (internal)", "responses": { "202": { "description": "Accepted" } } } },
    "/healthz": { "get": { "summary": "Liveness", "responses": { "200": { "description": "OK" } } } },
    "/readyz": { "get": { "summary": "Readiness", "responses": { "200": { "description": "Ready" }, "503": { "description": "Not ready" } } } },
    "/metrics": { "get": { "summary": "Prometheus metrics", "responses": { "200": { "description": "Metrics" } } } }
  }
}
