# ---------------------------------------------------------------------------------------------
# IronMesh console environment. Copy to .env.local for development.
#
# Two naming schemes are accepted. The Helm chart (deploy/helm/ironmesh) injects the CONSOLE_* /
# NEXT_PUBLIC_APP_URL names; the shorter names below them are fallbacks for compose and local dev.
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle at build time.
# ---------------------------------------------------------------------------------------------

# --- Auth.js (next-auth v5) -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-32-byte-random-secret
# Set to true behind a reverse proxy that terminates TLS (trust X-Forwarded-Host/Proto).
AUTH_TRUST_HOST=true
# Public URL of the console, used for OIDC redirect URIs. NEXT_PUBLIC_APP_URL is what the Helm
# chart sets; AUTH_URL is the Auth.js native name and wins when both are present. It also defines
# the console origin for the CSRF Origin check on API mutations, and an https URL switches the
# session cookie to Secure + __Host- prefix (SameSite=Strict either way).
NEXT_PUBLIC_APP_URL=https://console.example.com
# AUTH_URL=https://console.example.com

# --- Generic OIDC provider (Keycloak, Entra ID, Okta, Auth0, Dex ...) ----------------------------
# The issuer must publish /.well-known/openid-configuration; access tokens must carry
# aud=ironmesh-api. Precedence: CONSOLE_OIDC_* > AUTH_OIDC_* > NEXT_PUBLIC_OIDC_*.
CONSOLE_OIDC_ISSUER=https://idp.example.com/realms/ironmesh
CONSOLE_OIDC_CLIENT_ID=ironmesh-console
CONSOLE_OIDC_CLIENT_SECRET=change-me
# AUTH_OIDC_ISSUER=
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# Informational copies the chart exposes to the browser (not read by the console at runtime).
NEXT_PUBLIC_OIDC_ISSUER=https://idp.example.com/realms/ironmesh
NEXT_PUBLIC_OIDC_CLIENT_ID=ironmesh-console
NEXT_PUBLIC_OIDC_AUDIENCE=ironmesh-api
# Claim names carrying the tenant role and tenant id (defaults shown).
AUTH_ROLE_CLAIM=role
AUTH_TENANT_CLAIM=tenant_id
AUTH_TENANT_NAME_CLAIM=tenant_name

# --- Step-up re-authentication ---------------------------------------------------------------
# Quarantine, release, decommission, device config writes, policy save, API key create/revoke,
# tenant settings, user role changes and campaign start/halt/rollback require a sign-in no older
# than this many seconds (OIDC auth_time). Older sessions get a 401 step_up_required problem and
# the UI re-authenticates with prompt=login&max_age=0. Default 300; values below 30 are raised to 30.
CONSOLE_STEP_UP_MAX_AGE=300

# --- Upstream services (server-side only; the browser never sees these) -------------------------
# Precedence: CONSOLE_<SERVICE>_URL > <SERVICE>_URL > http://localhost:<port>.
CONSOLE_REGISTRY_URL=http://registry:8000
CONSOLE_OTA_URL=http://ota:8001
CONSOLE_ANOMALY_URL=http://anomaly:8002
CONSOLE_POLICY_URL=http://policy:8081
# REGISTRY_URL=http://localhost:8000
# OTA_URL=http://localhost:8001
# ANOMALY_URL=http://localhost:8002
# POLICY_URL=http://localhost:8081

# --- Browser-facing configuration -----------------------------------------------------------------
# Deployment label shown next to the tenant badge (anything but prod/production is displayed).
NEXT_PUBLIC_ENVIRONMENT=staging
# WebSocket endpoint of the registry (`GET /v1/ws`). Must be exposed by the reverse proxy on the
# console origin. Defaults to wss://<NEXT_PUBLIC_APP_URL host>/v1/ws, then to the current origin.
NEXT_PUBLIC_WS_URL=wss://console.example.com/v1/ws
# MapLibre style URL. Leave empty to use the bundled OpenStreetMap raster style.
NEXT_PUBLIC_MAP_STYLE_URL=
# Comma-separated tile origins allowed by the Content-Security-Policy (img-src / connect-src).
# Read per request by src/middleware.ts, which builds the nonce-based CSP.
MAP_TILE_ORIGINS=https://tile.openstreetmap.org

# --- Demo mode -----------------------------------------------------------------------------------
# Serve realistic fixtures from a Mock Service Worker in the browser instead of calling the
# services, and enable the "Demo sign-in" provider. Never enable in production.
NEXT_PUBLIC_MOCK_API=false
# Build output directory override used by the mock build (`npm run build:mock`).
# NEXT_DIST_DIR=.next-mock
