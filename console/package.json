{
  "name": "ironmesh-console",
  "version": "0.1.0",
  "private": true,
  "description": "IronMesh fleet console: Next.js 15 operator UI for the IronMesh IoT security framework",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "prebuild:mock": "node scripts/copy-maplibre-worker.mjs",
    "build:mock": "cross-env NEXT_PUBLIC_MOCK_API=true NEXT_DIST_DIR=.next-mock next build",
    "start": "next start",
    "start:mock": "cross-env NEXT_PUBLIC_MOCK_API=true NEXT_DIST_DIR=.next-mock next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cross-env NEXT_PUBLIC_MOCK_API=true NEXT_DIST_DIR=.next-mock playwright test",
    "lhci": "cross-env NEXT_PUBLIC_MOCK_API=true NEXT_DIST_DIR=.next-mock node scripts/lhci.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "msw:init": "msw init public --save"
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-table": "8.21.3",
    "@uiw/react-codemirror": "4.25.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.67.0",
    "maplibre-gl": "6.16.0",
    "msw": "2.15.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.32"
    }
  }
}
