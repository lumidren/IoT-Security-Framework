# ---------------------------------------------------------------------------------------------
# IronMesh local compose environment. Copy to deploy/docker/.env (git-ignored).
#
# scripts/demo/quickstart.sh / quickstart.ps1 create .env from this file and replace every
# __GENERATE__ with a fresh random 32-byte hex value. If you copy it by hand, replace them
# yourself (e.g. `openssl rand -hex 32`). Values must be URL-safe: some are embedded in DSNs.
#
# These are compose interpolation variables; docker-compose.yml maps them onto the exact
# variable names each service reads (see deploy/docker/README.md).
# ---------------------------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=ironmesh
# Image tag for locally built images (ghcr.io/lumidren/ironmesh-<name>:<tag>).
IRONMESH_TAG=dev

# Host interfaces. Operator UIs (console, Keycloak, registry API/WebSocket, Grafana, Prometheus,
# EMQX dashboard) stay on loopback; device-facing ports (EMQX 8883, PKI 8443/8444) can be
# opened to the LAN for hardware devices (HIL runner: IRONMESH_DEVICE_BIND_ADDR=0.0.0.0).
IRONMESH_BIND_ADDR=127.0.0.1
IRONMESH_DEVICE_BIND_ADDR=127.0.0.1
# Extra SANs for the broker / PKI server certificates (e.g. the runner's LAN IP for real boards).
IRONMESH_EMQX_EXTRA_SANS=
IRONMESH_PKI_EXTRA_SANS=
# Broker host written into the device trust bundle (compose network name by default).
IRONMESH_BROKER_HOST=emqx

# --- demo tenant, user and fleet ----------------------------------------------------------------
# Tenant id used by the demo realm claims, the registry seed and the fleet identities.
IRONMESH_TENANT_ID=7e4b1a9c-3c2e-4a4f-9c1b-0f0d2d7a6a11
IRONMESH_DEMO_USER=demo
# Keycloak user id = OIDC `sub` = registry owner user.
IRONMESH_DEMO_USER_ID=0c5c9b4e-6d1f-4b2a-9e57-3f1d8a2b7c10
IRONMESH_DEMO_PASSWORD=__GENERATE__
# Synthetic devices written by the registry seed (python -m app.seed) next to the live fleet.
IRONMESH_SEED_DEVICES=25
# Virtual fleet (ironmesh-fleet): software-key devices and misbehaving devices.
IRONMESH_FLEET_COUNT=500
IRONMESH_FLEET_ANOMALOUS=1
IRONMESH_FLEET_TELEMETRY_INTERVAL_S=10
# Stage dwell for the quickstart campaign (seconds).
IRONMESH_DEMO_DWELL_S=30

# --- PostgreSQL (delivered to the postgres container as compose secrets) -----------------------
POSTGRES_ADMIN_PASSWORD=__GENERATE__
PKI_DB_OWNER_PASSWORD=__GENERATE__
PKI_DB_PASSWORD=__GENERATE__
REGISTRY_DB_OWNER_PASSWORD=__GENERATE__
REGISTRY_DB_PASSWORD=__GENERATE__
OTA_DB_OWNER_PASSWORD=__GENERATE__
OTA_DB_PASSWORD=__GENERATE__
ANOMALY_DB_OWNER_PASSWORD=__GENERATE__
ANOMALY_DB_PASSWORD=__GENERATE__
BACKUP_DB_PASSWORD=__GENERATE__

# --- PKI ------------------------------------------------------------------------------------------
PKI_FILE_KMS_PASSPHRASE=__GENERATE__
# PKI -> policy revocation push: bearer (= POLICY_PKI_TOKEN) and HMAC key (= POLICY_PKI_HMAC_SECRET).
PKI_POLICY_TOKEN=__GENERATE__
PKI_POLICY_HMAC_KEY=__GENERATE__

# --- per-caller registry internal tokens (REGISTRY_INTERNAL_TOKENS); must all differ ---------
PKI_REGISTRY_TOKEN=__GENERATE__
POLICY_REGISTRY_TOKEN=__GENERATE__
ANOMALY_INTERNAL_TOKEN=__GENERATE__
# OTA -> registry campaign resolve and OtaNotify downlink requests (the "ota" entry).
OTA_REGISTRY_TOKEN=__GENERATE__
# Shared bearer accepted on the OTA service's /internal/* endpoints.
OTA_INTERNAL_TOKEN=__GENERATE__

# --- broker -----------------------------------------------------------------------------------------
# EMQX_IMAGE=emqx/emqx:5.8.9
EMQX_NODE_COOKIE=__GENERATE__
EMQX_DASHBOARD_PASSWORD=__GENERATE__
# Header X-IronMesh-Hook-Token on EMQX -> policy authn/authz calls.
POLICY_HOOK_TOKEN=__GENERATE__
# EMQX bootstrap API keys (key names policy / registry / ota are fixed in docker-compose.yml).
EMQX_POLICY_API_SECRET=__GENERATE__
EMQX_REGISTRY_API_SECRET=__GENERATE__
EMQX_OTA_API_SECRET=__GENERATE__
# Bearer EMQX must present on the bridge's POST /emqx/events webhook (X-IronMesh-Hook-Token of
# the EMQX ironmesh_auth_events action).
BRIDGE_EVENTS_TOKEN=__GENERATE__

# --- OTA ---------------------------------------------------------------------------------------------
# Encrypts the firmware signing key ring (tenant command keys are held by the registry only).
OTA_SIGNING_PASSPHRASE=__GENERATE__
OTA_DOWNLOAD_HMAC_SECRET=__GENERATE__

# --- anomaly -----------------------------------------------------------------------------------------
ANOMALY_SIEM_WEBHOOK_SECRET=__GENERATE__

# --- console and identity provider ------------------------------------------------------------------
AUTH_SECRET=__GENERATE__
CONSOLE_OIDC_CLIENT_SECRET=__GENERATE__
KEYCLOAK_ADMIN_PASSWORD=__GENERATE__

# --- observability ------------------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=__GENERATE__
# OTLP backends for the collector (no Tempo/Loki in the default stack; the debug exporter logs).
OTEL_TRACES_ENDPOINT=tempo:4317
OTEL_LOGS_ENDPOINT=http://loki:3100/otlp
# OTELCOL_IMAGE=otel/opentelemetry-collector-contrib:0.164.0
